{
  "name": "olx-engagement-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "session:connect": "tsx src/browser/session-cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.3.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.0.0",
    "pino": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.0",
    "prisma": "^6.1.0",
    "telegraf": "^4.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
